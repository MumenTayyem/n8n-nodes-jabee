{
  "name": "n8n-nodes-jabee",
  "version": "0.1.1",
  "description": "Ask a person on WhatsApp before your n8n workflow does something irreversible, and send alerts from any workflow, without owning a WhatsApp number.",
  "license": "MIT",
  "homepage": "https://jabee.ai/docs/n8n/",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "whatsapp",
    "approvals",
    "human-in-the-loop",
    "alerts",
    "notifications",
    "jabee"
  ],
  "author": { "name": "Mumen Tayyem", "email": "hello@jabee.ai" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MumenTayyem/n8n-nodes-jabee.git"
  },
  "bugs": { "url": "https://github.com/MumenTayyem/n8n-nodes-jabee/issues" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "scan": "npx @n8n/scan-community-package n8n-nodes-jabee",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/JabeeApi.credentials.js"],
    "nodes": [
      "dist/nodes/Jabee/Jabee.node.js",
      "dist/nodes/Jabee/JabeeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.4",
    "@types/node": "^22.10.2",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "publishConfig": { "access": "public" }
}
